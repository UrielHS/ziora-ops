# --- Base de datos (la MISMA instancia y base que Event Ops) ---
# Local: docker compose de este repo (puerto 5433). Para compartir con tu Event Ops local usa :5432.
DATABASE_URL=postgres://eventops:eventops@localhost:5433/eventops
# Cloud Run (en lugar de DATABASE_URL):
# DB_SOCKET_PATH=/cloudsql/event-ops-509602:us-central1:event-ops-db
# DB_NAME=eventops
# DB_USER=ziora_ops
# DB_PASSWORD=  (secreto ziora-ops-db-password)

# --- Auth (mismo cliente OAuth de Google que Event Ops, con el redirect de ziora-ops agregado) ---
# En local puede quedar vacío. En producción: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
APP_URL=http://localhost:3001
# Solo desarrollo: entra sin Google como este usuario (debe existir en users). Se ignora en producción.
DEV_LOGIN_EMAIL=uriel@ziora.dev

# --- Correo (Resend) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM="Ziora <hola@ziora-copilot.com>"
UNSUBSCRIBE_SECRET=

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_REPOS=org/ziora-app,org/ziora-landing
GITHUB_WEBHOOK_SECRET=

# --- Demos: Google Calendar del CEO (delegación de dominio, sin llaves) ---
GOOGLE_INGEST_SA=event-ops-ingest@event-ops-509602.iam.gserviceaccount.com
GOOGLE_CALENDAR_SUBJECT=
DEMO_CALENDAR_ID=primary
# Texto que tienen los eventos de demo (título o descripción). Solo se leen esos eventos.
DEMO_EVENT_MATCH=Demo

# --- Webhooks entrantes ---
DEMO_WEBHOOK_SECRET=
BUG_INTAKE_KEY=
JOB_SECRET=localtest

# --- Ziora Copilot (Firebase): usuarios, planes y Ayuda y sugerencias (docs/PUENTE-ZIORA-APP.md) ---
ZIORA_APP_SNAPSHOT_URL=
ZIORA_APP_BRIDGE_SECRET=

# --- Solo local con PGlite (npm run db:local): una conexión a la vez ---
# DB_POOL_MAX=1

# --- Redes sociales y anuncios (docs/REDES-Y-ANUNCIOS.md) ---
# 32 bytes en base64 para cifrar tokens: openssl rand -base64 32
SOCIAL_TOKEN_KEY=
# META_GRAPH_VERSION=v21.0

# --- Comunidades: la landing resuelve /c/<código> con este secreto (Bearer) ---
COMMUNITY_LINK_SECRET=
# Dominio de las ligas cortas (por defecto https://ziora-copilot.com)
# LANDING_URL=https://ziora-copilot.com
